<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Golden Fingera | Luxury Barber – Skövde</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">

<style>
:root {
    --primary-color: #d4af37;
    --dark-bg: #121212;
    --card-bg: #1e1e1e;
    --text-color: #f1f1f1;
    --text-muted: #aaaaaa;
    --font-main: 'Poppins', sans-serif;
    --font-heading: 'Playfair Display', serif;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background-color: var(--dark-bg);
    color: var(--text-color);
    font-family: var(--font-main);
    line-height: 1.6;
}

header {
    padding: 80px 20px;
    text-align: center;
    background: linear-gradient(135deg, #1a1a1a, #0a0a0a);
    border-bottom: 2px solid var(--primary-color);
}

header h1 {
    font-family: var(--font-heading);
    font-size: 3rem;
    color: var(--primary-color);
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 10px;
}

header p {
    color: var(--text-muted);
    font-size: 1.1rem;
    margin: 5px 0;
}

section {
    max-width: 1000px;
    margin: 40px auto;
    padding: 20px;
}

h2 {
    text-align: center;
    font-family: var(--font-heading);
    color: var(--primary-color);
    font-size: 2.2rem;
    margin-bottom: 30px;
}

.cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
}

.card {
    background: var(--card-bg);
    padding: 30px;
    border-radius: 8px;
    border: 1px solid #333;
    text-align: center;
    transition: transform 0.3s ease, border-color 0.3s ease;
}

.card:hover {
    transform: translateY(-5px);
    border-color: var(--primary-color);
}

.card h3 {
    font-family: var(--font-heading);
    color: var(--text-color);
    margin-bottom: 10px;
}

.card.price {
    font-size: 1.25rem;
    font-weight: bold;
    color: var(--primary-color);
    margin-top: 15px;
}

form {
    max-width: 500px;
    margin: 0 auto;
    background: var(--card-bg);
    padding: 40px;
    border-radius: 8px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.5);
}

form input, form select, form button {
    width: 100%;
    padding: 15px;
    margin-bottom: 20px;
    background: #2a2a2a;
    border: 1px solid #444;
    color: var(--text-color);
    font-size: 1rem;
    border-radius: 4px;
}

form input:focus, form select:focus {
    border-color: var(--primary-color);
    outline: none;
}

form button {
    background: var(--primary-color);
    color: #000;
    font-weight: bold;
    text-transform: uppercase;
    cursor: pointer;
    border: none;
    transition: background 0.3s ease;
}

form button:hover {
    background: #fff;
}

footer {
    text-align: center;
    padding: 40px;
    background: #0a0a0a;
    color: var(--text-muted);
    font-size: 0.9rem;
    border-top: 1px solid #222;
}
</style>

body {
  margin: 0;
  font-family: 'Montserrat', sans-serif;
  background: radial-gradient(circle at top, #1a1a1a, #000);
  color: #fff;
}

/* HEADER */
header {
  padding: 80px 20px;
  text-align: center;
  background: linear-gradient(to bottom, #000, #111);
  border-bottom: 2px solid gold;
}
header h1 {
  font-family: 'Playfair Display', serif;
  font-size: 48px;
  letter-spacing: 4px;
  color: gold;
}
header p {
  margin: 10px 0;
  color: #ccc;
}

/* SECTIONS */
section {
  max-width: 1000px;
  margin: auto;
  padding: 60px 20px;
}

h2 {
  text-align: center;
  font-family: 'Playfair Display', serif;
  color: gold;
  margin-bottom: 40px;
  letter-spacing: 2px;
}

/* CARDS */
.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px,1fr));
  gap: 20px;
}
.card {
  background: linear-gradient(145deg, #0d0d0d, #1a1a1a);
  border: 1px solid gold;
  padding: 30px;
  text-align: center;
  box-shadow: 0 0 20px rgba(218,165,32,0.2);
}
.card .price {
  margin-top: 15px;
  font-size: 26px;
  color: gold;
}

/* FORM */
form {
  max-width: 500px;
  margin: auto;
}
form input, form select, form button {
  width: 100%;
  padding: 14px;
  margin: 10px 0;
  background: #0d0d0d;
  border: 1px solid gold;
  color: #fff;
  font-size: 15px;
}
form input::placeholder {
  color: #777;
}
form button {
  background: gold;
  color: #000;
  font-weight: bold;
  letter-spacing: 1px;
  cursor: pointer;
  transition: 0.3s;
}
form button:hover {
  background: #ffd700;
}
form button:disabled {
  background: #555;
  cursor: not-allowed;
}

.notice {
  text-align: center;
  color: #ff5555;
  margin-bottom: 20px;
}

/* FOOTER */
footer {
  text-align: center;
  padding: 30px 20px;
  border-top: 1px solid gold;
  color: #aaa;
  font-size: 14px;
}
</style>
</head>

<body>

<header>
  <h1>Golden Fingera</h1>
  <p>Luxury Barber – Skövde</p>
  <p>Owner: Omar | 14 Years Experience</p>
</header>

<section>
  <h2>Services & Prices</h2>
  <div class="cards">
    <div class="card">Haircut<div class="price">250 SEK</div></div>
    <div class="card">Beard<div class="price">250 SEK</div></div>
    <div class="card">Kids<div class="price">250 SEK</div></div>
  </div>
</section>

<section>
  <h2>Book Appointment</h2>
  <p class="notice" id="notice"></p>

  <form id="booking-form">
    <input type="text" name="name" placeholder="Full Name" required>
    <input type="tel" name="phone" placeholder="Phone Number" required>
    <input type="email" name="email" placeholder="Email Address" required>

    <select name="service" required>
      <option value="">Select Service</option>
      <option value="Haircut">Haircut</option>
      <option value="Beard">Beard</option>
      <option value="Haircut & Beard">Haircut & Beard</option>
    </select>

    <input type="date" name="date" id="date" required>
    <select name="time" id="time" required></select>

    <button type="submit">Confirm Booking</button>
  </form>
</section>

<section>
  <h2>Contact</h2>
  <div class="card">
    📍 Maristasvägen 86 – Skövde<br><br>
    📞 072-444-4101<br><br>
    📧 omar1tftnaze@gmail.com
  </div>
</section>

<footer>
  © 2025 Golden Fingera – All Rights Reserved
</footer>

<script src="https://cdn.jsdelivr.net/npm/emailjs-com@3/dist/email.min.js"></script>

<script>
(function(){
  emailjs.init("RdqnDhUxmbBR69lCQ");
})();

const dateInput = document.getElementById("date");
const timeSelect = document.getElementById("time");
const notice = document.getElementById("notice");
const button = document.querySelector("form button");

dateInput.addEventListener("change", () => {
  timeSelect.innerHTML = "";
  const day = new Date(dateInput.value).getDay();

  if (day === 5 || day === 6) {
    notice.textContent = "Friday & Saturday: Walk-in only (No online booking)";
    button.disabled = true;
    return;
  }

  notice.textContent = "";
  button.disabled = false;

  for (let h = 10; h <= 17; h++) {
    const opt = document.createElement("option");
    opt.value = h + ":00";
    opt.textContent = h + ":00";
    timeSelect.appendChild(opt);
  }
});

document.getElementById("booking-form").addEventListener("submit", function(e){
  e.preventDefault();

  emailjs.sendForm(
    "service_osd1mqu",
    "template_erd8bqc",
    this
  ).then(
    () => {
      alert("Booking confirmed! Check your email 📧");
      this.reset();
    },
    () => {
      alert("Error sending booking ❌");
    }
  );
});
</script>

</body>
